{
  "name": "pitchside",
  "private": true,
  "version": "0.1.0",
  "description": "Tournament organizer PWA for casual football groups: leagues, groups, Champions League style league phase, knockouts and street rules.",
  "license": "MIT",
  "author": "Resul Ovezmyradov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owezresul/pitchside.git"
  },
  "keywords": [
    "football",
    "soccer",
    "tournament",
    "bracket",
    "pwa",
    "react",
    "typescript"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:icons": "capacitor-assets generate --android --iconBackgroundColor '#0F2019' --splashBackgroundColor '#0F2019'"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.2",
    "@fontsource-variable/archivo": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
